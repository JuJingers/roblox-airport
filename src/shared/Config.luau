--!strict
-- Все числа игры в одном месте.
--
-- Правило проекта: ни одно из этих значений не должно появиться в коде
-- напрямую. Баланс настраивается живыми игроками, и правка должна быть
-- одной цифрой здесь, а не поиском по файлам.
--
-- Тексты, которые видит игрок, — на английском: игра англоязычная,
-- остальные языки закрывает автоперевод Roblox.

local Types = require(script.Parent.Types)

local Config = {}

-- ─────────────────────────────────────────────────────────────
-- Игра
-- ─────────────────────────────────────────────────────────────

Config.GameName = "Baggage Rush"
Config.Version = "0.1.0"

-- ─────────────────────────────────────────────────────────────
-- Лента
-- ─────────────────────────────────────────────────────────────

-- Секунд на путь чемодана от начала ленты до конца.
--
-- Главная ручка темпа игры: чем больше, тем больше времени на решение
-- по каждому чемодану. Двенадцати не хватало — игра шла так бодро,
-- что не успеваешь понять, что происходит.
Config.BeltTravelSeconds = 16

-- Промежуток между приходами пассажиров. Чемоданы появляются только
-- вместе с ними, поэтому это и есть главная ручка темпа.
Config.PassengerInterval = 1.8

-- Минимальная пауза между двумя чемоданами на ленте.
--
-- Без неё быстрый игрок освобождает ленту, несколько пассажиров кладут
-- багаж почти одновременно, и чемоданы слипаются в одной точке.
-- При длине ленты 60 и пути 12 секунд лента идёт со скоростью 5 единиц
-- в секунду, так что 1.2 секунды дают просвет около шести единиц.
Config.MinBagGapSeconds = 1.2

-- Сколько чемоданов лента старается держать на себе.
--
-- Пассажиры не выходят, если лента уже загружена: иначе очередь растёт
-- бесконечно, а чемодану некуда встать. И наоборот — разобрал быстро,
-- пришёл следующий. Давление держится само.
Config.TargetBagsOnBelt = 4

-- Сколько чемоданов может ехать одновременно.
Config.BeltCapacity = 8

-- Доехавший до конца чемодан не пропадает, а встаёт в очередь.
--
-- Иначе игра наказывала бы за отвлечение на рамку: две её собственные
-- задачи дрались бы между собой. С очередью провал двухступенчатый —
-- сначала видно, что отстаёшь, и только при переполнении идут потери.
Config.QueueCapacity = 6

-- Куда складывается очередь и с каким шагом.
Config.QueueStart = Vector3.new(34, 4, 0)
Config.QueueStep = Vector3.new(4, 0, 0)

-- Геометрия ленты. Держим здесь, чтобы сервер и клиент считали
-- положение чемодана по одним и тем же точкам.
Config.BeltStart = Vector3.new(-30, 4, 0)
Config.BeltEnd = Vector3.new(30, 4, 0)
Config.BeltWidth = 8
Config.BagSize = Vector3.new(3, 2, 4)

-- ─────────────────────────────────────────────────────────────
-- Плоты
-- ─────────────────────────────────────────────────────────────

-- Восемь мест на карте, по одному на игрока. Все координаты ниже —
-- смещения от начала плота, а не мировые точки: иначе восемь аэропортов
-- построились бы друг на друге.
Config.PlotCount = 8
Config.PlotSize = Vector3.new(400, 300)
Config.PlotColumns = 4

-- Промежутки между плотами: по ним идут тропинки, и в них же уходит
-- запас на будущее расширение аэропорта.
-- Промежуток заполняется тропинкой целиком, поэтому отдельной ширины
-- у неё нет: иначе по краям остаются провалы до общей земли.
Config.PlotGap = Vector3.new(70, 90)

-- Ворота захвата стоят у входа на плот. Свободные пускают и выдают
-- базу, занятые пропускают в гости, но управление там не работает.
Config.ClaimGateOffset = Vector3.new(-185, 3, -12)
Config.ClaimGateSize = Vector3.new(4, 12, 20)

-- ─────────────────────────────────────────────────────────────
-- Улица и парковка
-- ─────────────────────────────────────────────────────────────

-- Такси подъезжает, пассажир выходит и идёт в здание. Улица и парковка —
-- ещё одна зона под декор, а заодно объяснение, откуда берутся люди.
Config.TaxiStopOffset = Vector3.new(-140, 3, -12)
Config.TaxiSpawnOffset = Vector3.new(-190, 3, -12)
Config.TaxiSize = Vector3.new(12, 5, 6)
Config.TaxiColor = Color3.fromRGB(226, 186, 62)
Config.TaxiSpeed = 34

Config.StreetCenterOffset = Vector3.new(-140, 3, -12)
Config.StreetSize = Vector3.new(90, 40)

-- ─────────────────────────────────────────────────────────────
-- Зал и путь пассажира
-- ─────────────────────────────────────────────────────────────

-- Всё происходит внутри одного здания: зал, пункт досмотра, лента,
-- жёлоба и будка охраны. Крыши нет намеренно — иначе камера сверху
-- ничего не увидит; для Roblox это обычное решение.
Config.BuildingCenter = Vector3.new(-20, 3, -12)
Config.BuildingSize = Vector3.new(154, 64)
Config.WallHeight = 16

-- Проёмы: вход со стороны улицы, выход с противоположной.
Config.EntryDoorWidth = 14
Config.ExitDoorWidth = 14

-- Вывеска над входом. По умолчанию берёт ник игрока, но её можно
-- будет сменить на любую надпись.
Config.SignSuffix = " AIRPORT"

-- Готовые места под декор. Игрок не расставляет свободно — он покупает
-- предмет, и тот встаёт в отведённую точку. Так проще и предсказуемее,
-- а свободную расстановку можно добавить позже, не ломая сохранения.
Config.DecorSlots = {
	Vector3.new(-84, 3, -22),
	Vector3.new(-72, 3, -22),
	Vector3.new(-60, 3, -22),
	Vector3.new(-84, 3, -2),
	Vector3.new(-72, 3, -2),
	Vector3.new(-60, 3, -2),
}

-- Пассажир входит, кладёт чемодан на ленту, проходит через рамку
-- и уходит. Чемоданы больше не возникают сами: у каждого есть хозяин.
Config.PassengerEntry = Vector3.new(-88, 3, -12)
Config.PassengerDropPoint = Vector3.new(-30, 3, -7)
Config.PassengerFramePoint = Vector3.new(0, 3, -12)
Config.PassengerExit = Vector3.new(44, 3, -14)

-- Скорость шага в единицах в секунду.
--
-- Поднята вместе с одноместным проходом: пока человек идёт от ленты
-- к рамке, следующий стоит в очереди, и медленный шаг оставлял бы
-- ленту голодной.
Config.PassengerSpeed = 17

-- Очередь перед приёмкой. Когда лента загружена, пассажиры не исчезают,
-- а встают в хвост: спрос должен быть виден. Растущая очередь говорит
-- «не справляешься» понятнее любой надписи.
Config.LineStart = Vector3.new(-38, 3, -7)
-- Шаг плотный: люди должны стоять очередью, а не редкой цепочкой
-- через полкарты. Раньше восемь человек растягивались на 36 единиц.
Config.LineStep = Vector3.new(-3.2, 0, 0)
Config.LineCapacity = 6

-- Зона ожидания за рамкой: здесь пассажир ждёт свой чемодан.
-- Без неё люди уходили сразу, бросая багаж, и потеря чемодана
-- оставалась абстрактной прибавкой к счётчику.
-- Ждущие стоят компактной группой в два ряда, а не длинной шеренгой.
Config.WaitStart = Vector3.new(16, 3, -20)
Config.WaitStep = Vector3.new(3.4, 0, 0)
Config.WaitRowStep = Vector3.new(0, 0, -3.4)
Config.WaitPerRow = 3

-- Потолок зоны ожидания. Без него толпа росла без предела: если игрок
-- отстаёт, люди копятся и загромождают весь пункт. Не дождавшийся
-- уходит расстроенным — как в жизни.
Config.WaitCapacity = 6

-- Рамка стоит посередине пункта, лента сбоку.
Config.FramePosition = Vector3.new(0, 3, -12)

-- ─────────────────────────────────────────────────────────────
-- Досмотр
-- ─────────────────────────────────────────────────────────────

-- Доля пассажиров, которых следует досмотреть.
Config.SuspiciousChance = 0.25

-- Какая часть подозрительных звенит на рамке.
--
-- Смешанный режим намеренный: если бы звенели все, игрок ждал бы
-- звука и не смотрел на людей. Звенящий останавливается сам и никуда
-- не денется, а молчащий идёт к выходу — вот он и есть работа.
Config.BeepChance = 0.6

-- Сколько звенящий ждёт досмотра, прежде чем плюнуть и уйти.
--
-- Предохранитель против тупика: он перекрывает проход, и если игрок
-- не заметит красную рамку, игра встала бы навсегда. Уход засчитывается
-- как ускользнувший — давление остаётся, безвыходность уходит.
Config.SearchPatienceSeconds = 20

-- Сколько секунд идёт проверка. Это время лента едет без присмотра,
-- поэтому цена досмотра — не штраф, а упущенный багаж.
Config.SearchSeconds = 3

-- ─────────────────────────────────────────────────────────────
-- Ручная кладь
-- ─────────────────────────────────────────────────────────────

-- Сколько вещей показываем при досмотре.
Config.ItemsPerCheck = 3

-- Что нельзя провозить. Это второй растущий свод правил: со ступенями
-- список будет пополняться, и наставник будет его показывать.
local prohibited: { Types.ItemKind } = { "Knife", "Liquid", "Lighter" }
Config.ProhibitedItems = prohibited

local allItems: { Types.ItemKind } = { "Clothes", "Book", "Phone", "Knife", "Liquid", "Lighter" }
Config.AllItems = allItems

-- Вещи различаются цветом и формой, не подписью: аудитория многоязычная.
Config.ItemColors = {
	Clothes = Color3.fromRGB(120, 170, 210),
	Book = Color3.fromRGB(150, 130, 200),
	Phone = Color3.fromRGB(110, 200, 180),
	Knife = Color3.fromRGB(220, 90, 80),
	Liquid = Color3.fromRGB(230, 150, 70),
	Lighter = Color3.fromRGB(215, 110, 150),
}

-- Насколько часто у отмеченного пассажира действительно есть запрещённое.
--
-- Меньше единицы намеренно: отметка означает «проверь», а не «виновен».
-- Иначе досмотр свёлся бы к «заметил и нажал», без всякого решения.
Config.GuiltyChance = 0.6

-- Сколько обычный пассажир стоит в рамке, проходя её.
--
-- Тормозят все, а не только звенящие: иначе молчащего подозрительного
-- нельзя было бы досмотреть вовсе, и оттенок терял бы смысл. Это окно —
-- шанс поймать того, кого рамка не поймала.
--
-- Полутора секунд не хватало: если игрок в этот момент разбирал чемодан,
-- шанса не было физически, и игра наказывала за собственную же вторую
-- задачу.
Config.FramePauseSeconds = 2.5

-- ─────────────────────────────────────────────────────────────
-- Охрана
-- ─────────────────────────────────────────────────────────────

-- Двое стоят у рамки и уводят задержанных в будку.
Config.GuardPosts = {
	Vector3.new(-9, 3, -20),
	Vector3.new(9, 3, -20),
}
Config.GuardBooth = Vector3.new(0, 3, -34)
Config.GuardColor = Color3.fromRGB(70, 110, 200)
Config.GuardSpeed = 18

-- Цвета состояний пассажира.
Config.PassengerCalmColor = Color3.fromRGB(196, 196, 204)
-- Молчащий подозрительный отличается оттенком: заметно, но не кричаще.
Config.PassengerSuspectColor = Color3.fromRGB(150, 146, 168)
Config.PassengerHappyColor = Color3.fromRGB(150, 220, 160)
Config.PassengerUpsetColor = Color3.fromRGB(226, 120, 110)
-- Три состояния рамки. Зелёная и красная показывают вердикт сканера,
-- а не истину: у части красных ничего запрещённого нет, а часть тихих
-- провозит. Иначе досмотр был бы не нужен — хватило бы взгляда на цвет.
Config.FrameIdleColor = Color3.fromRGB(158, 164, 172)
Config.FrameClearColor = Color3.fromRGB(96, 186, 120)
Config.FrameAlertColor = Color3.fromRGB(228, 96, 84)

-- Цвета бирок. Ключи совпадают с Types.Destination.
Config.DestinationColors = {
	Red = Color3.fromRGB(196, 62, 48),
	Blue = Color3.fromRGB(48, 108, 196),
	Green = Color3.fromRGB(62, 152, 82),
	Yellow = Color3.fromRGB(214, 176, 48),
}

Config.VipColor = Color3.fromRGB(232, 190, 72)

-- ─────────────────────────────────────────────────────────────
-- Какие чемоданы приезжают
-- ─────────────────────────────────────────────────────────────

-- Аннотация на локальной переменной, а не приведение через `::`:
-- иначе Luau выводит элементы как обычные строки и теряет перечисление.
local destinations: { Types.Destination } = { "Red", "Blue", "Green", "Yellow" }
Config.Destinations = destinations

-- Доли особых чемоданов. Применяются только с той ступени,
-- на которой соответствующее правило открыто.
Config.OversizedChance = 0.15
Config.FragileChance = 0.12
Config.FlaggedChance = 0.10

-- VIP-гость с золотым чемоданом. Заметен глазом и платит больше —
-- ради него покупают бустер.
Config.VipChance = 0.05

-- ─────────────────────────────────────────────────────────────
-- Оплата
-- ─────────────────────────────────────────────────────────────

Config.BasePayPerBag = 10

-- Во сколько раз золотой чемодан дороже обычного.
Config.VipPayMultiplier = 5

-- Штраф за ошибку: доля от стоимости чемодана. Единица означает
-- «потерял ровно то, что заработал бы».
--
-- Баланс никогда не уходит ниже нуля: наказание должно раздражать,
-- а не разорять.
Config.MisSortPenalty = 1.0

-- ─────────────────────────────────────────────────────────────
-- Кривая стоимости
-- ─────────────────────────────────────────────────────────────

-- Цена покупки номер n = BaseCost * CostGrowth ^ (n - 1).
--
-- Смысл коэффициента — держать время до следующей покупки примерно
-- постоянным. Тогда у игрока всё время есть ощущение «почти накопил».
-- Для симуляторов обычный диапазон 1.15…1.35.
--
-- При 1.2 третья покупка случалась за те же пять минут, что отведены
-- на первую, а всё дерево выкупалось за полчаса. Поднято ближе к
-- верхней границе: первая покупка остаётся быстрой, дальше растягивается.
Config.CostGrowth = 1.32

-- ─────────────────────────────────────────────────────────────
-- Доход в отсутствие игрока
-- ─────────────────────────────────────────────────────────────

-- Какую долю от активной игры даёт автоматика.
-- Выше — перестанут играть руками, ниже — не станут возвращаться.
Config.OfflineRate = 0.25

-- Потолок накопления, секунды. Восемь часов делают оптимальным
-- заход примерно раз в день — ровно та метрика, по которой нас ранжируют.
-- Больше — развалится суточная петля, меньше — обидно за пропущенное.
Config.BacklogCapSeconds = 8 * 60 * 60

-- Надбавка за разбор завала. Ниже — незачем разгребать,
-- выше — выгоднее не играть.
Config.BacklogPayMultiplier = 1.5

-- ─────────────────────────────────────────────────────────────
-- Ступени правил
-- ─────────────────────────────────────────────────────────────

-- Открываются по уровню игрока, а не по общему таймеру: на постоянном
-- сервере Roblox игроки заходят в разное время, и общий отсчёт рассыпается.
Config.Tiers = {
	{ tier = 1, unlockAtBags = 0, rule = "Destination colour" },
	{ tier = 2, unlockAtBags = 40, rule = "Oversized goes to its own chute" },
	{ tier = 3, unlockAtBags = 120, rule = "Fragile must not ride the main belt" },
	{ tier = 4, unlockAtBags = 260, rule = "Flagged bags go to security" },
}

Config.MaxTier = 4

-- ─────────────────────────────────────────────────────────────
-- Обучение
-- ─────────────────────────────────────────────────────────────

-- Сколько чемоданов ведём стрелкой. После этого игрок работает сам.
Config.TutorialGuidedBags = 4

-- Во время обучения лента идёт медленнее.
Config.TutorialSpawnInterval = 6.0

-- Ошибка в обучении показывает последствие, но не наказывает.
Config.TutorialPenaltyEnabled = false

-- ─────────────────────────────────────────────────────────────
-- Апгрейды
-- ─────────────────────────────────────────────────────────────

-- Первая покупка обязана случиться в первые пять минут игры,
-- поэтому стартовая цена намеренно низкая.
-- Улучшения покупаются за деньги и действуют сразу.
--
-- Порядок цен задаёт порядок покупок, и первым должно идти то, что
-- расшивает узкое место. Узкое место сейчас — сам досмотр: три секунды
-- проверки плюс запертый проход. Поэтому Faster Check самый дешёвый,
-- а Faster Lane, который наоборот усиливает поток, стоит дороже всех:
-- его берут, когда уже справляешься.
local upgrades: { Types.Upgrade } = {
	{
		id = "FastCheck",
		displayName = "Fast Check",
		baseCost = 80,
		maxCount = 6,
	},
	{
		id = "ExtraStorage",
		displayName = "Extra Storage",
		baseCost = 140,
		maxCount = 6,
	},
	{
		id = "BetterScanner",
		displayName = "Better Scanner",
		baseCost = 200,
		maxCount = 5,
	},
	{
		id = "FasterLane",
		displayName = "Faster Lane",
		baseCost = 260,
		maxCount = 8,
	},
}
Config.Upgrades = upgrades

-- Что даёт одна ступень каждого улучшения.
Config.UpgradeEffects = {
	FastCheck = { checkCut = 0.3 },
	ExtraStorage = { queueBonus = 1 },
	BetterScanner = { beepBonus = 0.06 },
	FasterLane = { speedBonus = 2.5, pauseCut = 0.08 },
}

-- Нижняя граница времени проверки: полностью убрать её нельзя,
-- иначе досмотр перестанет чего-либо стоить.
Config.MinSearchSeconds = 1.2

return Config
